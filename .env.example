# ---------------------------------------------------------------------------
# Centixio environment. Copy to .env.local and fill in what you have.
# Missing integrations fall back to clearly labeled demo behavior; nothing
# pretends a real payment or AI call happened.
# ---------------------------------------------------------------------------

# Public URL of the app (used for Stripe redirects, signed demo asset URLs, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (auth, Postgres, storage). Without these, local demo mode is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose. (Legacy name SUPABASE_SERVICE_ROLE_KEY also works.)
SUPABASE_SECRET_KEY=

# --- AI provider (server-only)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Production without an AI key disables generation unless you explicitly allow the rule-based composer:
# ALLOW_RULES_COMPOSER=1

# --- Stripe (server-only). Billing is disabled until all five are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDIT_PACK=

# --- Jobs
# "inline": run jobs right after enqueue via next/server after() (plus cron sweeps).
# "worker": leave jobs for `npm run worker` (recommended for long generations).
JOB_RUNNER=inline
# Protects /api/cron/jobs (call it every minute with Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# --- Demo mode (only used when Supabase is not configured)
# Allowed automatically in development. Set to 1 to allow in production builds, 0 to forbid.
# CENTIXIO_DEMO_MODE=
# Required if demo mode runs in production:
# DEMO_SESSION_SECRET=
